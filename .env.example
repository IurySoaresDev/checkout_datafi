# === Banco de Dados ===
# Será preenchido com as credenciais reais
DATABASE_URL=postgresql+asyncpg://user:password@localhost:5432/checkout_db

# === GG Checkout ===
# API Key: GG Checkout → Configurações → MCP / API Key (formato: ggck_live_...)
GGCHECKOUT_API_KEY=ggck_live_sua_chave_aqui

# URL base da API do GG Checkout
GGCHECKOUT_API_URL=https://www.ggcheckout.com/api

# Secret para validação HMAC dos webhooks
# Configure em: GG Checkout → Configurações → Webhooks → Secret
GGCHECKOUT_WEBHOOK_SECRET=seu_webhook_secret_aqui

# === Geral ===
APP_BASE_URL=https://seusite.com
ENVIRONMENT=development
